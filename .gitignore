# ---------------------------------------------------------------------------
# Working material (kept locally; not part of consumer releases)
# ---------------------------------------------------------------------------
/docs/superpowers/
/docs/ENGINEERING_BACKLOG.md
/foundissues/
/AGENTS.md

# Agent / assistant tooling state. Local configuration and caches, not project
# source. (.kiro/ previously sat under virtual environments, which it is not.)
/.agents/
/.codex/
/.codex-worktrees/
.kiro/

# Generated code-review output. Written per run and named by timestamp, so it
# would otherwise pile up one untracked file at a time.
/semantic-review/

# Local sounding render outputs
/rendered_soundings/*
!/rendered_soundings/.gitkeep
/CLAUDE.md

# ---------------------------------------------------------------------------
# Virtual environments (recreate with `pip install -e ".[dev,era5,wrf]"`)
# ---------------------------------------------------------------------------
.gribenv/
.griblenv/
.rendertest/
.venv/
venv/
env/
ENV/

# Local credentials and environment overrides. Keep a sanitized example file.
.env
.env.*
!.env.example
.cdsapirc

# ---------------------------------------------------------------------------
# Python bytecode / build artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
.eggs/
*.egg-info/
build/
dist/
wheels/
pip-wheel-metadata/
*.manifest
*.spec
# Native-extension build output is local and can be regenerated with Cargo.
/rust/**/target/
# ...but keep the maintained PyInstaller spec for the standalone GUI build.
!packaging/sharpmod_gui.spec

