{
  "name": "sharppy-reimagined-frontend",
  "private": true,
  "version": "3.2.1",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode live --port 5174",
    "dev:fixture": "vite --mode fixture --port 5174",
    "build": "tsc -b && vite build",
    "build:browser": "vite build --mode live --outDir dist-browser",
    "preview:browser": "vite preview --mode live --outDir dist-browser",
    "build:fixture": "vite build --mode fixture --outDir dist-fixture",
    "preview:fixture": "vite preview --mode fixture --outDir dist-fixture",
    "typecheck": "tsc -b",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/maplibre": "9.4.0",
    "@tanstack/react-query": "5.104.1",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-updater": "2.14.0",
    "lucide-react": "1.51.0",
    "maplibre-gl": "6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
