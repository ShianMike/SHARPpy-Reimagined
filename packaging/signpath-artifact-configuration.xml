<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set
      product-name="SHARPpy Reimagined"
      product-version="${version}"
      file-version="${version}"
      company-name="SHARPpy Reimagined maintainers"
      copyright="Copyright (c) SHARPpy Reimagined maintainers"
      original-filename="SHARPpy-Reimagined.exe">
      <include path="recommended/SHARPpy-Reimagined.exe" />
      <include path="portable/SHARPpy-Reimagined.exe" />
      <for-each>
        <authenticode-sign
          description="SHARPpy Reimagined"
          description-url="https://github.com/ShianMike/SHARPpy-Reimagined" />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
