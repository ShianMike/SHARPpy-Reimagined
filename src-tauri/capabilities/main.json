{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: app commands, backend status events, fullscreen, and signed updates.",
  "windows": ["main"],
  "permissions": [
    "allow-get-backend-health",
    "allow-get-station-catalog",
    "allow-restart-backend",
    "allow-get-storage-usage",
    "allow-clear-cache",
    "allow-get-model-catalog",
    "allow-get-model-status",
    "allow-open-sounding",
    "allow-get-sounding-progress",
    "allow-inspect-wrf",
    "allow-get-sounding-analysis",
    "allow-get-sounding-trends",
    "allow-get-threshold-metrics",
    "allow-evaluate-threshold",
    "allow-export-threshold-csv",
    "allow-render-sounding",
    "allow-render-sounding-view",
    "allow-get-map-catalog",
    "allow-get-weather-field",
    "allow-get-spc-outlook",
    "allow-get-radar-frame",
    "allow-get-radar-site-frame",
    "allow-get-radar-sites",
    "allow-get-satellite-frame",
    "allow-get-storm-reports",
    "allow-get-report-options",
    "allow-get-field-contours",
    "allow-get-surface-plots",
    "allow-get-place-labels",
    "allow-get-station-availability",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:resources:allow-close",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
