{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SHARPpy Reimagined",
  "identifier": "io.github.shianmike.sharppy-reimagined",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SHARPpy Reimagined",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: https://tiles.openfreemap.org",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.openfreemap.org",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
